---
import { ArrowRight, CheckCircle2, Search } from '@lucide/astro';
import { builderPages, type BuilderFeaturePageConfig } from '@/data/builder-pages';
import { BuilderPageFaq } from '@/components/builder-pages/builder-page-faq';
import { BUILDER_URL, getBuilderProjectCreateUrl, getFeaturePagePath } from '@/lib/site-config';

interface Props {
  page: BuilderFeaturePageConfig;
}

const { page } = Astro.props;
const relatedPages = Object.values(builderPages).filter((entry) => entry.slug !== page.slug);
const builderCreateLink =
  page.slug === 'portfolio-builder'
    ? getBuilderProjectCreateUrl({ type: 'portfolio', starter: 'resume-first' })
    : page.slug === 'linktree-builder'
      ? getBuilderProjectCreateUrl({ type: 'linktree', starter: 'creator' })
      : getBuilderProjectCreateUrl({ type: 'menu', starter: 'cafe' });
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "name": page.title,
      "description": page.description,
      "url": Astro.url.href,
      "keywords": page.keywords.join(", "),
    },
    {
      "@type": "SoftwareApplication",
      "name": `Kislap ${page.eyebrow}`,
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web",
      "description": page.description,
      "url": BUILDER_URL,
    },
    {
      "@type": "FAQPage",
      "mainEntity": page.faq.map((item) => ({
        "@type": "Question",
        "name": item.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.answer,
        },
      })),
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Features",
          "item": new URL("/features", Astro.url.origin).toString(),
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": page.eyebrow,
          "item": Astro.url.href,
        },
      ],
    },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />

<main class="w-full max-w-full overflow-x-hidden bg-white text-black">
  <section class="border-b-4 border-black px-4 py-20 md:py-28">
    <div class="container mx-auto grid max-w-7xl gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:items-end">
      <div class="space-y-8">
        <p class="font-mono text-sm font-bold uppercase tracking-[0.28em] text-primary">{page.eyebrow}</p>
        <div class="space-y-6">
          <h1 class="max-w-6xl text-4xl font-black uppercase leading-[0.95] tracking-normal md:text-6xl lg:text-7xl">
            {page.heroTitle}
          </h1>
          <p class="max-w-3xl text-xl font-semibold leading-relaxed md:text-2xl">{page.heroLead}</p>
          <p class="max-w-2xl text-base leading-relaxed text-zinc-700 md:text-lg">{page.heroBody}</p>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row">
          <a href={builderCreateLink} class="inline-flex items-center justify-center border-2 border-black bg-secondary px-6 py-3 text-base font-black uppercase text-black shadow-[6px_6px_0_#000] transition hover:-translate-y-1 hover:shadow-[9px_9px_0_#000]">
            Start building now
            <ArrowRight class="ml-2 h-4 w-4" />
          </a>
          <a href="/showcase" class="inline-flex items-center justify-center border-2 border-black bg-white px-6 py-3 text-base font-black uppercase text-black transition hover:-translate-y-1 hover:bg-black hover:text-white">
            Browse live examples
          </a>
        </div>
      </div>

      <div class="relative lg:pl-8">
        <div class="border-4 border-black bg-zinc-300 p-5 shadow-[12px_12px_0_#000]">
          <div class="flex h-[420px] flex-col justify-between border-2 border-black bg-zinc-200 p-6 text-black">
            <p class="font-mono text-xs font-bold uppercase tracking-[0.24em]">Replace image: 2400 x 1400</p>
            <div>
              <p class="text-3xl font-black uppercase">Builder screen</p>
              <p class="mt-2 max-w-sm text-sm font-semibold text-zinc-700">{page.eyebrow} workspace preview</p>
            </div>
          </div>
        </div>
        <div class="absolute -bottom-8 right-4 hidden w-[42%] border-4 border-black bg-zinc-100 p-3 shadow-[8px_8px_0_#000] md:block">
          <div class="flex h-[220px] flex-col justify-between bg-zinc-300 p-4">
            <p class="font-mono text-[10px] font-bold uppercase tracking-[0.2em]">Replace image: 1200 x 1600</p>
            <p class="text-xl font-black uppercase">Public page</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="px-4 py-24 md:py-32">
    <div class="container mx-auto grid max-w-7xl gap-8 lg:grid-cols-12 lg:grid-flow-dense">
      <div class="border-4 border-black bg-black p-8 text-white lg:col-span-5">
        <p class="font-mono text-sm font-bold uppercase tracking-[0.26em] text-secondary">Made for</p>
        <h2 class="mt-5 text-3xl font-black uppercase leading-tight md:text-5xl">{page.audienceTitle}</h2>
      </div>
      <div class="grid gap-0 border-4 border-black lg:col-span-7 sm:grid-cols-2">
        {page.audience.map((entry) => (
          <div class="flex min-h-36 gap-4 border-black p-5 odd:border-b even:border-b sm:odd:border-r">
            <CheckCircle2 class="mt-1 h-5 w-5 shrink-0 text-primary" />
            <p class="text-base font-bold leading-relaxed">{entry}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-y-4 border-black bg-secondary px-4 py-24 md:py-32">
    <div class="container mx-auto max-w-7xl">
      <div class="max-w-5xl">
        <p class="font-mono text-sm font-bold uppercase tracking-[0.26em]">{page.featureTitle}</p>
        <h2 class="mt-5 text-4xl font-black uppercase leading-none md:text-6xl">{page.featureLead}</h2>
      </div>
      <div class="mt-12 grid grid-flow-dense gap-0 border-4 border-black bg-white lg:grid-cols-3">
        {page.features.map((feature) => (
          <article class="group border-black p-7 transition hover:bg-primary hover:text-white lg:border-r last:lg:border-r-0">
            <h3 class="text-2xl font-black uppercase leading-tight">{feature.title}</h3>
            <p class="mt-4 text-base font-semibold leading-relaxed">{feature.description}</p>
            <ul class="mt-6 space-y-3">
              {feature.bullets.map((bullet) => (
                <li class="flex gap-3 text-sm font-bold leading-relaxed">
                  <CheckCircle2 class="mt-0.5 h-4 w-4 shrink-0" />
                  <span>{bullet}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="px-4 py-24 md:py-32">
    <div class="container mx-auto grid max-w-7xl gap-10 lg:grid-cols-[0.8fr_1.2fr]">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <p class="font-mono text-sm font-bold uppercase tracking-[0.26em] text-primary">{page.workflowTitle}</p>
        <h2 class="mt-5 text-4xl font-black uppercase leading-none md:text-6xl">Publish without dragging the process out.</h2>
      </div>
      <div class="space-y-6">
        {page.workflow.map((item) => (
          <div class="border-4 border-black bg-white p-7 shadow-[8px_8px_0_#000]">
            <p class="font-mono text-sm font-bold uppercase tracking-[0.24em] text-primary">{item.step}</p>
            <h3 class="mt-4 text-3xl font-black uppercase">{item.title}</h3>
            <p class="mt-3 max-w-2xl text-base font-semibold leading-relaxed text-zinc-700">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-y-4 border-black bg-black px-4 py-24 text-white md:py-32">
    <div class="container mx-auto grid max-w-7xl gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:items-start">
      <div class="space-y-6">
        <p class="inline-flex items-center gap-2 font-mono text-sm font-bold uppercase tracking-[0.24em] text-secondary">
          <Search class="h-4 w-4" />
          Easier to find and share
        </p>
        <h2 class="text-4xl font-black uppercase leading-none md:text-6xl">
          Your page should work after the link leaves your hands.
        </h2>
        <p class="max-w-2xl text-lg font-semibold leading-relaxed text-zinc-300">
          Kislap shapes the public page, social preview, and page structure so people can understand what you publish before they click.
        </p>
      </div>
      <div class="grid gap-3 sm:grid-cols-2">
        {page.keywords.map((keyword, index) => (
          <div class:list={[
            "border-2 border-white px-4 py-4 font-mono text-sm font-bold uppercase tracking-[0.16em]",
            index % 3 === 0 && "bg-secondary text-black",
            index % 3 === 1 && "bg-white text-black",
            index % 3 === 2 && "bg-primary text-white",
          ]}>
            {keyword}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="container mx-auto max-w-5xl px-4 py-24 md:py-32">
    <div class="text-center">
      <p class="font-mono text-sm font-bold uppercase tracking-[0.26em] text-primary">Before you start</p>
      <h2 class="mt-4 text-4xl font-black uppercase leading-none md:text-6xl">
        Straight answers before you publish.
      </h2>
    </div>
    <BuilderPageFaq client:load items={page.faq} slug={page.slug} />
  </section>

  <section class="container mx-auto max-w-7xl px-4 pb-24 md:pb-32">
    <div class="border-4 border-black bg-primary px-6 py-16 text-center text-white shadow-[12px_12px_0_#000] md:px-16 md:py-20">
      <h2 class="mx-auto max-w-5xl text-4xl font-black uppercase leading-none md:text-6xl">
        Start with a focused builder and ship the page people need to see.
      </h2>
      <p class="mx-auto mt-5 max-w-2xl text-lg font-semibold leading-relaxed text-white/90">
        Pick the direction, add your real content, and publish when it feels sharp enough to share.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href={builderCreateLink} class="inline-flex items-center justify-center border-2 border-black bg-secondary px-6 py-3 text-base font-black uppercase text-black shadow-[6px_6px_0_#000] transition hover:-translate-y-1">
          Open the builder
          <ArrowRight class="ml-2 h-4 w-4" />
        </a>
        <a href="/showcase" class="inline-flex items-center justify-center border-2 border-white px-6 py-3 text-base font-black uppercase text-white transition hover:bg-white hover:text-black">
          See live examples
        </a>
      </div>
    </div>
  </section>

  <section class="container mx-auto max-w-7xl px-4 pb-24 md:pb-32">
    <div class="grid gap-6 md:grid-cols-2">
      {relatedPages.map((entry) => (
        <a href={getFeaturePagePath(entry.slug)} class="group border-4 border-black bg-white p-8 shadow-[8px_8px_0_#000] transition hover:-translate-y-1 hover:bg-secondary">
          <p class="font-mono text-sm font-bold uppercase tracking-[0.24em] text-primary">{entry.eyebrow}</p>
          <h3 class="mt-4 text-3xl font-black uppercase leading-tight">{entry.heroTitle}</h3>
          <p class="mt-4 text-base font-semibold leading-relaxed text-zinc-700">{entry.description}</p>
          <span class="mt-6 inline-flex items-center text-sm font-black uppercase text-black">
            Explore this builder
            <ArrowRight class="ml-2 h-4 w-4 transition-transform group-hover:translate-x-1" />
          </span>
        </a>
      ))}
    </div>
  </section>
</main>
