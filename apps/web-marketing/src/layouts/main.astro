---
import { LogoVersion } from '@/components/logo-version';
import { BUILDER_URL, CONTACT_EMAIL, getFeaturePagePath, getSiteUrl } from '@/lib/site-config';
import '@fontsource/outfit/400.css';
import '@fontsource/outfit/600.css';
import '@fontsource/outfit/700.css';
import '@fontsource/outfit/900.css';
import '@fontsource/jetbrains-mono';
import '@/styles/global.css';
import { 
  Menu, 
  X, 
  Github, 
  MessageCircle, 
  Mail,
  ArrowUpRight,
  ChevronDown
} from '@lucide/astro';
import { buttonVariants } from "@/components/ui/button";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  canonical?: string;
  noindex?: boolean;
}

const { 
  title = "Kislap - Turn forms into websites",
  description = "No drag and drop chaos. No design skills needed. Just fill in the blanks, and Kislap generates a high-performance site instantly.",
  image = "/og-image.jpeg",
  type = "website",
  canonical,
  noindex = false,
} = Astro.props;

const site = Astro.site ? Astro.site : Astro.url.origin;
const canonicalURL = new URL(canonical || Astro.url.pathname, site);
const currentYear = new Date().getFullYear();
const builderUrl = BUILDER_URL;
const showcaseUrl = getSiteUrl('/showcase');
const aboutUrl = getSiteUrl('/about');
const featuresUrl = getSiteUrl('/features');
const helpUrl = getSiteUrl('/help');

const PUBLIC_LINKS = [
  { title: 'Showcase', url: '/showcase' },
  { title: 'About us', url: '/about' },
  { title: 'Help', url: '/help' },
];

const BUILDER_LINKS = [
  { title: 'Portfolio Builder', url: getFeaturePagePath('portfolio-builder') },
  { title: 'Link Page Builder', url: getFeaturePagePath('linktree-builder') },
  { title: 'Digital Menu Builder', url: getFeaturePagePath('menu-builder') },
];
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex,follow" />}

    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Kislap" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, site)} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, site)} />

    <script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Kislap",
  "url": site
})} />

    <script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Kislap",
  "url": site,
  "logo": new URL('/og-image.jpeg', site).toString(),
  "sameAs": [
    "https://github.com/bastilavarias/kislap",
    "https://discord.gg/YcmUebEWhT"
  ]
})} />

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SiteNavigationElement",
  "name": ["Features", ...PUBLIC_LINKS.map(l => l.title), ...BUILDER_LINKS.map(l => l.title), "Builder"],
  "url": [
    featuresUrl,
    ...PUBLIC_LINKS.map(l => new URL(l.url, site).toString()),
    ...BUILDER_LINKS.map(l => new URL(l.url, site).toString()),
    builderUrl
  ]
})} />
  </head>
  <body class="min-h-screen bg-white text-black font-sans antialiased flex flex-col">
    
    <header class="sticky top-0 z-50 w-full border-b-4 border-black bg-secondary">
      <div class="mx-auto flex min-h-20 max-w-7xl items-center justify-between gap-4 px-4 py-3 md:px-6">
        
        <div class="flex items-center gap-8">
          <LogoVersion url="/" />
        </div>

        <nav class="hidden items-center gap-3 md:flex" aria-label="Main Navigation">
          <ul class="m-0 flex list-none items-center gap-3 p-0">
            <li class="group relative">
              <button
                type="button"
                class="inline-flex h-12 items-center gap-2 border-4 border-black bg-white px-4 font-mono text-sm font-black uppercase text-black shadow-[4px_4px_0_#000] transition-all hover:-translate-y-0.5 hover:bg-primary hover:text-white"
                aria-haspopup="true"
              >
                Builders
                <ChevronDown class="h-4 w-4 transition-transform group-hover:rotate-180" />
              </button>

              <div class="invisible absolute right-0 top-full z-50 mt-4 min-w-[260px] translate-y-2 border-4 border-black bg-white p-2 opacity-0 shadow-[8px_8px_0_#000] transition-all duration-200 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100">
                {BUILDER_LINKS.map((link) => (
                  <a
                    href={link.url}
                    class="flex items-center justify-between border-b-4 border-black px-4 py-3 text-sm font-black uppercase text-black transition last:border-b-0 hover:bg-secondary"
                  >
                    <span>{link.title}</span>
                    <ArrowUpRight class="h-4 w-4" />
                  </a>
                ))}
              </div>
            </li>
            {PUBLIC_LINKS.map((link) => (
              <li>
                <a 
                  href={link.url} 
                  class="inline-flex h-12 items-center border-4 border-black bg-white px-4 font-mono text-sm font-black uppercase text-black shadow-[4px_4px_0_#000] transition-all hover:-translate-y-0.5 hover:bg-secondary"
                >
                  {link.title}
                </a>
              </li>
            ))}
            <li>
              <a 
                href={builderUrl} 
                class={`${buttonVariants({ variant: "default", size: "lg" })} h-12 rounded-none border-4 border-black bg-primary px-5 font-black uppercase text-white shadow-[5px_5px_0_#000] transition-all hover:translate-x-1 hover:translate-y-1 hover:bg-primary/90 hover:shadow-[2px_2px_0_#000]`}
              >
                Visit Builder
              </a>
            </li>
          </ul>
        </nav>

        <button id="mobile-menu-btn" class="border-4 border-black bg-white p-2 text-black shadow-[4px_4px_0_#000] md:hidden">
          <Menu class="w-6 h-6" id="menu-icon" />
          <X class="w-6 h-6 hidden" id="close-icon" />
        </button>
      </div>

      <div id="mobile-menu" class="hidden space-y-3 border-t-4 border-black bg-white px-4 py-5 text-center shadow-[0_8px_0_#000] md:hidden">
        <details class="border-4 border-black bg-secondary px-4 py-3 text-left shadow-[5px_5px_0_#000]">
          <summary class="flex cursor-pointer list-none items-center justify-between font-mono text-sm font-black uppercase text-black">
            <span>Builders</span>
            <ChevronDown class="h-4 w-4" />
          </summary>
          <div class="mt-3 space-y-2">
            {BUILDER_LINKS.map((link) => (
              <a
                href={link.url}
                class="flex items-center justify-between border-4 border-black bg-white px-3 py-2 text-sm font-black uppercase text-black"
              >
                <span>{link.title}</span>
                <ArrowUpRight class="h-4 w-4" />
              </a>
            ))}
          </div>
        </details>
        {PUBLIC_LINKS.map((link) => (
          <a 
            href={link.url} 
            class="flex items-center justify-center border-4 border-black bg-white px-4 py-3 font-mono text-sm font-black uppercase text-black shadow-[5px_5px_0_#000]"
          >
            {link.title}
          </a>
        ))}
        <a 
          href={builderUrl} 
          class={`${buttonVariants({ variant: "default", size: "lg" })} h-14 w-full rounded-none border-4 border-black bg-primary font-black uppercase text-white shadow-[5px_5px_0_#000]`}
        >
          Visit Builder
        </a>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t-4 border-black bg-black px-4 py-16 text-white md:py-24">
      <div class="mx-auto max-w-7xl">
        <div class="grid gap-6 lg:grid-cols-[1.1fr_0.9fr]">
          <div class="border-4 border-white bg-primary p-7 shadow-[12px_12px_0_#fff] md:p-10">
            <div class="w-fit">
              <LogoVersion url="/" />
            </div>
            <h2 class="mt-10 max-w-3xl text-5xl font-black uppercase leading-[0.88] md:text-7xl">
              Forms in. Public pages out.
            </h2>
            <p class="mt-7 max-w-2xl text-xl font-semibold leading-relaxed text-white/90">
              Kislap helps people publish portfolios, link pages, and QR-ready menus without dragging blocks around an empty canvas.
            </p>
            <div class="mt-8 flex flex-col gap-4 sm:flex-row">
              <a
                href={builderUrl}
                class={`${buttonVariants({ variant: "secondary", size: "lg" })} h-14 rounded-none border-4 border-black bg-white px-6 font-black uppercase text-black shadow-[6px_6px_0_#000] hover:bg-secondary`}
              >
                Open Builder
                <ArrowUpRight class="h-4 w-4" />
              </a>
              <a
                href="https://github.com/bastilavarias/kislap"
                target="_blank"
                rel="noreferrer"
                class={`${buttonVariants({ variant: "outline", size: "lg" })} h-14 rounded-none border-4 border-white bg-black px-6 font-black uppercase text-white shadow-[6px_6px_0_#fff] hover:bg-zinc-900`}
              >
                <Github class="h-4 w-4" />
                GitHub
              </a>
            </div>
          </div>

          <div class="grid gap-6 sm:grid-cols-2">
            <div class="border-4 border-white bg-white p-6 text-black shadow-[10px_10px_0_#ef4444]">
              <h4 class="font-mono text-sm font-black uppercase tracking-[0.18em]">
                Product
              </h4>
              <div class="mt-6 flex flex-col gap-3">
                {[
                  { title: 'Builder', url: builderUrl },
                  { title: 'Features', url: featuresUrl },
                  { title: 'Showcase', url: showcaseUrl },
                  { title: 'Portfolio Builder', url: getFeaturePagePath('portfolio-builder') },
                  { title: 'Link Page Builder', url: getFeaturePagePath('linktree-builder') },
                  { title: 'Digital Menu Builder', url: getFeaturePagePath('menu-builder') },
                ].map((link) => (
                  <a
                    href={link.url}
                    class="flex items-center justify-between border-b-4 border-black pb-2 text-sm font-black uppercase transition hover:text-primary"
                  >
                    <span>{link.title}</span>
                    <ArrowUpRight class="h-4 w-4" />
                  </a>
                ))}
              </div>
            </div>

            <div class="border-4 border-white bg-secondary p-6 text-black shadow-[10px_10px_0_#ef4444]">
              <h4 class="font-mono text-sm font-black uppercase tracking-[0.18em]">
                Contact
              </h4>
              <div class="mt-6 flex flex-col gap-3">
                <a
                  href={aboutUrl}
                  class="flex items-center justify-between border-b-4 border-black pb-2 text-sm font-black uppercase transition hover:text-primary"
                >
                  <span>About Us</span>
                  <ArrowUpRight class="h-4 w-4" />
                </a>
                <a
                  href={helpUrl}
                  class="flex items-center justify-between border-b-4 border-black pb-2 text-sm font-black uppercase transition hover:text-primary"
                >
                  <span>Help</span>
                  <ArrowUpRight class="h-4 w-4" />
                </a>
                <a
                  href={`mailto:${CONTACT_EMAIL}`}
                  class="flex items-center gap-3 border-b-4 border-black pb-2 text-sm font-black uppercase transition hover:text-primary"
                >
                  <Mail class="h-4 w-4 shrink-0" />
                  <span class="break-all">{CONTACT_EMAIL}</span>
                </a>
              </div>
              <div class="mt-6 flex gap-3">
                <a
                  href="https://github.com/bastilavarias/kislap"
                  target="_blank"
                  rel="noreferrer"
                  class="flex h-12 w-12 items-center justify-center border-4 border-black bg-white shadow-[4px_4px_0_#000] transition hover:-translate-y-0.5"
                >
                  <Github class="h-5 w-5" />
                  <span class="sr-only">GitHub</span>
                </a>
                <a
                  href="https://discord.gg/YcmUebEWhT"
                  target="_blank"
                  rel="noreferrer"
                  class="flex h-12 w-12 items-center justify-center border-4 border-black bg-white shadow-[4px_4px_0_#000] transition hover:-translate-y-0.5"
                >
                  <MessageCircle class="h-5 w-5" />
                  <span class="sr-only">Discord</span>
                </a>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-10 flex flex-col gap-4 border-4 border-white bg-white px-5 py-4 font-mono text-sm font-black uppercase text-black shadow-[8px_8px_0_#ef4444] md:flex-row md:items-center md:justify-between">
          <p>&copy; {currentYear} Kislap. All rights reserved.</p>
          <a
            href="https://github.com/bastilavarias"
            class="w-fit underline decoration-4 underline-offset-4 transition hover:text-primary"
          >
            Built by bastilavarias
          </a>
        </div>
      </div>
    </footer>

    <script>
      const menuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      const menuIcon = document.getElementById('menu-icon');
      const closeIcon = document.getElementById('close-icon');

      if (menuBtn && mobileMenu && menuIcon && closeIcon) {
        menuBtn.addEventListener('click', () => {
          mobileMenu.classList.toggle('hidden');
          menuIcon.classList.toggle('hidden');
          closeIcon.classList.toggle('hidden');
        });
      }
    </script>
  </body>
</html>
