---
import { LogoVersion } from '@/components/logo-version';
import { BUILDER_URL, CONTACT_EMAIL, getSiteUrl } from '@/lib/site-config';
import { HOME_SEO } from '@/lib/seo';
import '@fontsource/outfit/400.css';
import '@fontsource/outfit/600.css';
import '@fontsource/outfit/700.css';
import '@fontsource/outfit/900.css';
import '@fontsource/jetbrains-mono';
import '@/styles/global.css';
import { 
  Menu, 
  X, 
  Github, 
  MessageCircle, 
  Mail,
  ArrowUpRight,
} from '@lucide/astro';
import { buttonVariants } from "@/components/ui/button";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  canonical?: string;
  noindex?: boolean;
  keywords?: string[];
}

const { 
  title = HOME_SEO.title,
  description = HOME_SEO.description,
  image = "/og-image.jpeg",
  type = "website",
  canonical,
  noindex = false,
  keywords = HOME_SEO.keywords,
} = Astro.props;

const site = Astro.site ? Astro.site : Astro.url.origin;
const canonicalURL = new URL(canonical || Astro.url.pathname, site);
const currentYear = new Date().getFullYear();
const builderUrl = BUILDER_URL;
const showcaseUrl = getSiteUrl('/showcase');
const aboutUrl = getSiteUrl('/about');
const helpUrl = getSiteUrl('/help');
const schemaBuilderUrl =
  builderUrl.includes('localhost') || builderUrl.includes('127.0.0.1')
    ? 'https://builder.kislap.app'
    : builderUrl;
const schemaSiteUrl = (path: string) => new URL(path, site).toString();

const PUBLIC_LINKS = [
  { title: 'Showcase', url: '/showcase' },
  { title: 'About us', url: '/about' },
  { title: 'Help', url: '/help' },
];

---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex,follow" />}

    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Kislap" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, site)} />
    <meta property="og:image:alt" content={description} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, site)} />
    <meta name="twitter:image:alt" content={description} />

    <script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Kislap",
  "url": site
})} />

    <script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Kislap",
  "url": site,
  "logo": new URL('/assets/logo.png', site).toString(),
  "sameAs": [
    "https://github.com/bastilavarias/kislap",
    "https://discord.gg/YcmUebEWhT"
  ]
})} />

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SiteNavigationElement",
  "name": [...PUBLIC_LINKS.map(l => l.title), "Builder"],
  "url": [
    ...PUBLIC_LINKS.map(l => schemaSiteUrl(l.url)),
    schemaBuilderUrl
  ]
})} />
  </head>
  <body class="min-h-screen bg-white text-black font-sans antialiased flex flex-col">
    
    <header class="sticky top-0 z-50 w-full border-b-4 border-black bg-secondary">
      <div class="mx-auto flex min-h-20 max-w-7xl items-center justify-between gap-4 px-4 py-3 md:px-6">
        
        <div class="flex items-center gap-8">
          <LogoVersion url="/" />
        </div>

        <nav class="hidden items-center gap-3 md:flex" aria-label="Main Navigation">
          <ul class="m-0 flex list-none items-center gap-3 p-0">
            {PUBLIC_LINKS.map((link) => (
              <li>
                <a 
                  href={link.url} 
                  class="inline-flex h-12 items-center border-4 border-black bg-white px-4 font-mono text-sm font-black uppercase text-black shadow-[4px_4px_0_#000] transition-all hover:-translate-y-0.5 hover:bg-secondary"
                >
                  {link.title}
                </a>
              </li>
            ))}
            <li>
              <a 
                href={builderUrl} 
                class={`${buttonVariants({ variant: "default", size: "lg" })} h-12 rounded-none border-4 border-black bg-primary px-5 font-mono text-sm font-black uppercase text-white shadow-[5px_5px_0_#000] transition-all hover:translate-x-1 hover:translate-y-1 hover:bg-primary/90 hover:shadow-[2px_2px_0_#000]`}
              >
                Visit Builder
              </a>
            </li>
          </ul>
        </nav>

        <button id="mobile-menu-btn" class="border-4 border-black bg-white p-2 text-black shadow-[4px_4px_0_#000] md:hidden">
          <Menu class="w-6 h-6" id="menu-icon" />
          <X class="w-6 h-6 hidden" id="close-icon" />
        </button>
      </div>

      <div id="mobile-menu" class="hidden space-y-3 border-t-4 border-black bg-white px-4 py-5 text-center shadow-[0_8px_0_#000] md:hidden">
        {PUBLIC_LINKS.map((link) => (
          <a 
            href={link.url} 
            class="flex items-center justify-center border-4 border-black bg-white px-4 py-3 font-mono text-sm font-black uppercase text-black shadow-[5px_5px_0_#000]"
          >
            {link.title}
          </a>
        ))}
        <a 
          href={builderUrl} 
          class={`${buttonVariants({ variant: "default", size: "lg" })} h-14 w-full rounded-none border-4 border-black bg-primary font-mono text-sm font-black uppercase text-white shadow-[5px_5px_0_#000]`}
        >
          Visit Builder
        </a>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t-4 border-black bg-black px-4 py-16 text-white md:py-24">
      <div class="mx-auto max-w-7xl">
        <div class="grid gap-6 lg:grid-cols-[1.1fr_0.9fr]">
          <div class="border-4 border-white bg-primary p-7 shadow-[12px_12px_0_#fff] md:p-10">
            <div class="w-fit">
              <LogoVersion url="/" showVersion />
            </div>
            <h2 class="mt-10 max-w-3xl text-5xl font-black uppercase leading-[0.88] md:text-7xl">
              Forms in. Public pages out.
            </h2>
            <p class="mt-7 max-w-2xl text-xl font-semibold leading-relaxed text-white/90">
              Kislap helps people publish portfolios, link pages, and QR-ready menus without dragging blocks around an empty canvas.
            </p>
            <div class="mt-8 flex flex-col gap-4 sm:flex-row">
              <a
                href={builderUrl}
                class={`${buttonVariants({ variant: "secondary", size: "lg" })} h-14 rounded-none border-4 border-black bg-white px-6 font-black uppercase text-black shadow-[6px_6px_0_#000] hover:bg-secondary`}
              >
                Open Builder
                <ArrowUpRight class="h-4 w-4" />
              </a>
              <a
                href="https://github.com/bastilavarias/kislap"
                target="_blank"
                rel="noreferrer"
                class={`${buttonVariants({ variant: "outline", size: "lg" })} h-14 rounded-none border-4 border-white bg-black px-6 font-black uppercase text-white shadow-[6px_6px_0_#fff] hover:bg-zinc-900`}
              >
                <Github class="h-4 w-4" />
                GitHub
              </a>
            </div>
          </div>

          <div class="border-4 border-white bg-white text-black shadow-[10px_10px_0_#ef4444]">
            <div class="border-b-4 border-black bg-secondary p-6">
              <p class="font-mono text-xs font-black uppercase tracking-[0.2em] text-black/70">
                Explore Kislap
              </p>
              <h3 class="mt-3 text-3xl font-black uppercase leading-none">
                Pick a builder or get help.
              </h3>
            </div>

            <div class="grid md:grid-cols-[0.82fr_1.18fr]">
              <div class="border-b-4 border-black p-6 md:border-b-0 md:border-r-4">
                <h4 class="font-mono text-sm font-black uppercase tracking-[0.18em]">
                  Product
                </h4>
                <div class="mt-6 flex flex-col gap-3">
                  {[
                    { title: 'Open Builder', url: builderUrl },
                    { title: 'Showcase', url: showcaseUrl },
                  ].map((link) => (
                    <a
                      href={link.url}
                      class="flex items-center justify-between border-b-2 border-black pb-2 text-sm font-black uppercase transition hover:text-primary"
                    >
                      <span>{link.title}</span>
                      <ArrowUpRight class="h-4 w-4" />
                    </a>
                  ))}
                </div>
              </div>

              <div class="p-6">
                <h4 class="font-mono text-sm font-black uppercase tracking-[0.18em]">
                  Company
                </h4>
                <div class="mt-6 flex flex-col gap-3">
                  <a
                    href={aboutUrl}
                    class="flex items-center justify-between border-b-2 border-black pb-2 text-sm font-black uppercase transition hover:text-primary"
                  >
                    <span>About Us</span>
                    <ArrowUpRight class="h-4 w-4" />
                  </a>
                  <a
                    href={helpUrl}
                    class="flex items-center justify-between border-b-2 border-black pb-2 text-sm font-black uppercase transition hover:text-primary"
                  >
                    <span>Help</span>
                    <ArrowUpRight class="h-4 w-4" />
                  </a>
                  <a
                    href={`mailto:${CONTACT_EMAIL}`}
                    class="flex min-w-0 items-center gap-3 border-b-2 border-black pb-2 text-sm font-black uppercase transition hover:text-primary"
                  >
                    <Mail class="h-4 w-4 shrink-0" />
                    <span class="min-w-0 [overflow-wrap:anywhere]">{CONTACT_EMAIL}</span>
                  </a>
                </div>

                <div class="mt-6 flex gap-3">
                  <a
                    href="https://github.com/bastilavarias/kislap"
                    target="_blank"
                    rel="noreferrer"
                    class="flex h-12 w-12 items-center justify-center border-4 border-black bg-white shadow-[4px_4px_0_#000] transition hover:-translate-y-0.5"
                  >
                    <Github class="h-5 w-5" />
                    <span class="sr-only">GitHub</span>
                  </a>
                  <a
                    href="https://discord.gg/YcmUebEWhT"
                    target="_blank"
                    rel="noreferrer"
                    class="flex h-12 w-12 items-center justify-center border-4 border-black bg-white shadow-[4px_4px_0_#000] transition hover:-translate-y-0.5"
                  >
                    <MessageCircle class="h-5 w-5" />
                    <span class="sr-only">Discord</span>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-10 flex flex-col gap-4 border-4 border-white bg-secondary px-5 py-4 font-mono text-sm font-black uppercase text-black shadow-[8px_8px_0_#fff] md:flex-row md:items-center md:justify-between">
          <p>&copy; {currentYear} Kislap. All rights reserved.</p>
          <a
            href="https://github.com/bastilavarias"
            class="w-fit underline decoration-4 underline-offset-4 transition hover:text-primary"
          >
            Built by bastilavarias
          </a>
        </div>
      </div>
    </footer>

    <script>
      const menuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      const menuIcon = document.getElementById('menu-icon');
      const closeIcon = document.getElementById('close-icon');

      if (menuBtn && mobileMenu && menuIcon && closeIcon) {
        menuBtn.addEventListener('click', () => {
          mobileMenu.classList.toggle('hidden');
          menuIcon.classList.toggle('hidden');
          closeIcon.classList.toggle('hidden');
        });
      }
    </script>
  </body>
</html>
