---
export const prerender = false;
import Layout from '@/layouts/main.astro';
import { ArrowRight } from '@lucide/astro';
import { builderPages } from '@/data/builder-pages';
import { getFeaturePagePath } from '@/lib/site-config';

const title = "Features | Kislap";
const description =
  "Explore Kislap's portfolio builder, link page builder, and digital menu builder. Choose the right publishing flow for the page you actually need.";

const pages = Object.values(builderPages);

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "name": title,
      "description": description,
      "url": Astro.url.href,
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Features",
          "item": Astro.url.href,
        },
      ],
    },
  ],
};
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <main class="w-full max-w-full overflow-x-hidden bg-white text-black">
    <section class="border-b-4 border-black px-4 py-20 md:py-28">
      <div class="container mx-auto max-w-7xl">
        <p class="font-mono text-sm font-bold uppercase tracking-[0.28em] text-primary">Choose your public page</p>
        <h1 class="mt-6 max-w-6xl text-5xl font-black uppercase leading-[0.9] tracking-normal md:text-7xl lg:text-8xl">
          Pick the builder that matches what you need to publish.
        </h1>
        <p class="mt-7 max-w-3xl text-xl font-semibold leading-relaxed text-zinc-700">
          Kislap gives each format a focused workflow: personal proof, social routing, or a QR-ready menu.
        </p>
      </div>
    </section>

    <section class="px-4 py-24 md:py-32">
      <div class="container mx-auto grid max-w-7xl grid-flow-dense gap-6 lg:grid-cols-12">
        {pages.map((page) => (
          <a
            href={getFeaturePagePath(page.slug)}
            class:list={[
              "group border-4 border-black bg-white shadow-[8px_8px_0_#000] transition hover:-translate-y-1 hover:shadow-[12px_12px_0_#000]",
              page.slug === "portfolio-builder" && "lg:col-span-7",
              page.slug === "linktree-builder" && "lg:col-span-5",
              page.slug === "menu-builder" && "lg:col-span-12",
            ]}
          >
            <div class="grid min-h-full lg:grid-cols-[0.9fr_1.1fr]">
              <div class="flex min-h-[300px] flex-col justify-between border-b-4 border-black bg-zinc-300 p-6 lg:border-b-0 lg:border-r-4">
                <p class="font-mono text-xs font-bold uppercase tracking-[0.24em]">Replace image: 1800 x 1200</p>
                <div>
                  <p class="text-3xl font-black uppercase">{page.eyebrow}</p>
                  <p class="mt-2 max-w-sm text-sm font-bold text-zinc-700">Builder and public-page preview placeholder</p>
                </div>
              </div>
              <div class="flex flex-col justify-between p-7 md:p-9">
                <div>
                  <p class="font-mono text-sm font-bold uppercase tracking-[0.24em] text-primary">
                    {page.eyebrow}
                  </p>
                  <h2 class="mt-4 text-3xl font-black uppercase leading-tight md:text-5xl">
                    {page.heroTitle}
                  </h2>
                  <p class="mt-5 text-base font-semibold leading-relaxed text-zinc-700">
                    {page.description}
                  </p>
                  <div class="mt-6 flex flex-wrap gap-2">
                    {page.keywords.slice(0, 3).map((keyword) => (
                      <span class="border-2 border-black bg-secondary px-3 py-1 font-mono text-xs font-bold uppercase text-black">
                        {keyword}
                      </span>
                    ))}
                  </div>
                </div>
                <span class="mt-8 inline-flex items-center text-sm font-black uppercase text-black">
                  Explore feature page
                  <ArrowRight class="ml-2 h-4 w-4 transition-transform group-hover:translate-x-1" />
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="border-y-4 border-black bg-black px-4 py-20 text-white md:py-28">
      <div class="container mx-auto grid max-w-7xl gap-8 md:grid-cols-[1fr_0.7fr] md:items-end">
        <h2 class="max-w-5xl text-4xl font-black uppercase leading-none md:text-6xl">
          One account, three publishing paths, no blank-canvas drift.
        </h2>
        <p class="text-lg font-semibold leading-relaxed text-zinc-300">
          Start with the page type your audience actually needs, then tighten content and visuals inside that flow.
        </p>
      </div>
    </section>
  </main>
</Layout>
