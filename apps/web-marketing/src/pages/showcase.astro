---
export const prerender = false;
import Layout from '@/layouts/main.astro';
import { ShowcaseFeed } from '@/components/showcase-feed';
import { getPublicProjectUrl } from '@/lib/site-config';
import { PAGE_SEO } from '@/lib/seo';

const selectedType = "linktree" as const;
const apiUrl = new URL(`${import.meta.env.API_URL}/api/projects/list/public`);
apiUrl.searchParams.set("limit", "9");
apiUrl.searchParams.set("type", selectedType);

let initialProjects = [];
let initialMeta = null;

try {
  const response = await fetch(apiUrl);

  if (!response.ok) {
    console.error("API Error:", response.statusText);
  } else {
    const result = await response.json();
    const payload = result.data || result;
    const sourceProjects = Array.isArray(payload) ? payload : payload.data || [];
    initialProjects = sourceProjects.filter((project: any) => project.user_id !== 1);
    initialMeta = Array.isArray(payload) ? null : payload.meta || null;
  }
} catch (error) {
  console.error("Network/Fetch Error:", error);
}

const { title, description, keywords } = PAGE_SEO.showcase;

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": title,
  "description": description,
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": initialProjects.map((project: any, index: number) => ({
      "@type": "ListItem",
      "position": index + 1,
      "url": getPublicProjectUrl(project.sub_domain),
      "name": project.name
    }))
  }
};
---

<Layout title={title} description={description} keywords={keywords}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <section class="relative overflow-hidden border-b-4 border-black bg-white pb-32 pt-20">
    <div class="absolute inset-0 bg-[linear-gradient(#000_1px,transparent_1px),linear-gradient(90deg,#000_1px,transparent_1px)] bg-[size:44px_44px] opacity-[0.045]"></div>
    <div class="container relative mx-auto max-w-7xl px-4">
      <ShowcaseFeed
        client:load
        projects={initialProjects}
        apiBaseUrl={import.meta.env.API_URL}
        initialType={selectedType}
        initialMeta={initialMeta}
      />
    </div>
  </section>
</Layout>
