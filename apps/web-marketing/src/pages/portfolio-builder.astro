---
export const prerender = false;

import Layout from '@/layouts/main.astro';
import BuilderFeaturePage from '@/components/builder-pages/BuilderFeaturePage.astro';
import { builderPages } from '@/data/builder-pages';
import { getFeaturePagePath } from '@/lib/site-config';

const builderPagesEnabled = false;

if (!builderPagesEnabled) {
  return new Response("Not found", { status: 404 });
}

const page = builderPages["portfolio-builder"];
---

<Layout
  title={page.title}
  description={page.description}
  image={page.image}
  canonical={getFeaturePagePath(page.slug)}
  keywords={page.keywords}
  noindex={true}
>
  <BuilderFeaturePage page={page} />
</Layout>
