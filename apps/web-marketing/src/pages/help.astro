---
export const prerender = false;

import { HelpPageContent } from '@/components/help-page-content';
import Layout from '@/layouts/main.astro';
import { CONTACT_EMAIL, SITE_URL } from '@/lib/site-config';
import { PAGE_SEO } from '@/lib/seo';

const { title, description, keywords } = PAGE_SEO.help;

const schema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": title,
  "url": new URL('/help', SITE_URL).toString(),
  "description": description,
  "mainEntity": {
    "@type": "Organization",
    "name": "Kislap",
    "url": SITE_URL,
    "email": CONTACT_EMAIL
  }
};
---

<Layout title={title} description={description} keywords={keywords}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <HelpPageContent
    client:load
    apiBaseUrl={import.meta.env.API_URL}
    contactEmail={CONTACT_EMAIL}
  />
</Layout>
